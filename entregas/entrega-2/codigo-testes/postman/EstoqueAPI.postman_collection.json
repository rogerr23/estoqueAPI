              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p=pm.response.json().find(p=>p.produtoId===Number(pm.collectionVariables.get(\"seedProductId\"))); pm.collectionVariables.set(\"beforeOrigin\",p.quantidade); pm.test(\"Origem permite transferir 10\",()=>pm.expect(p.quantidade).to.be.at.least(10));"
            ]
          }
        }
      ]
    },
