    {
      "name": "06 — Produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p=pm.response.json().find(p=>p.codigo===\"PROD-001\"); pm.test(\"Produto de demonstração disponível\",()=>pm.expect(p).to.exist); if(p) pm.collectionVariables.set(\"seedProductId\",p.id); pm.collectionVariables.set(\"newCode\",\"POSTMAN-\"+Date.now());"
            ]
          }
        }
      ]
    },
    {
