      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lojas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const lojas=pm.response.json(); for (const [key,name] of [[\"originId\",\"Loja A\"],[\"destinationId\",\"Loja B\"]]) { const l=lojas.find(l=>l.nome===name); pm.test(name,()=>pm.expect(l).to.exist); if(l) pm.collectionVariables.set(key,l.id); }"
            ]
          }
        }
      ]
    },
    {
