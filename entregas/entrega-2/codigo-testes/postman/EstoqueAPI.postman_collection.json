{
  "info": {
    "name": "EstoqueAPI — Validação do MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar em ordem, em ambiente local de teste com carga dev e origem com saldo mínimo 10. Usa cookie jar e CSRF renovado em cada escrita. Cria um produto por execução e duas transferências que restauram os saldos ao final; o histórico permanece. Não executar contra produção. Credenciais somente no ambiente local não versionado."
  },
  "variable": [
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method === 'POST' && pm.request.headers.has('X-CSRF-TOKEN')) {",
          "  pm.sendRequest(pm.variables.get('baseUrl') + '/api/auth/csrf', (error, response) => {",
          "    if (error || response.code !== 200) throw new Error('Não foi possível obter CSRF');",
          "    pm.collectionVariables.set('csrfToken', response.json().token);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Sessão anônima",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Token antes do login",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Token disponível\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Credenciais inválidas",
      "request": {
